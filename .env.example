APP_NAME="Fintech Payment API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
APP_FORCE_HTTPS=true

LOG_CHANNEL=stack

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=payments
DB_USERNAME=root
DB_PASSWORD=

# Cache / Session (optional for API-only)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queues (Redis)
QUEUE_CONNECTION=redis

# Sanctum
SANCTUM_STATEFUL_DOMAINS="localhost"

# Paystack (simulate or real integration)
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL="https://api.paystack.co"

